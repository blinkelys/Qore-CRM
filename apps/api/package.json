{
  "name": "@qore/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run src/auth/integration.test.ts src/organizations/integration.test.ts src/modules/integration.test.ts",
    "modules:entitlement": "node --env-file-if-exists=../../.env src/modules/entitlement-cli.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --run db:migrate:cli",
    "db:migrate:cli": "node-pg-migrate up --migrations-dir migrations"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.3.2"
  }
}
