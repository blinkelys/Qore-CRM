{
  "name": "@qore/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env --run db:migrate:cli",
    "db:migrate:cli": "node-pg-migrate up --migrations-dir migrations"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.3.2"
  }
}
